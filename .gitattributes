* text=auto

# Hash-frozen research artifacts and code are checked out with LF on every OS.
# Several reports/manifests record SHA-256 digests over exact bytes; CRLF
# conversion makes those digests fail on Windows checkouts.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Binary artifacts are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
