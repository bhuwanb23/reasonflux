  "metric_definitions": {
    "PEARSON": {
      "failure_condition": "<= 0",
      "formula": "corr(IS, TS)",
      "interpretation": "linear IS-transfer correlation",
      "name": "PEARSON",
      "valid_range": "[-1, 1]"
    },
    "SPEARMAN": {
      "failure_condition": "<= 0",
      "formula": "corr(rank(IS), rank(TS))",
      "interpretation": "rank IS-transfer correlation",
      "name": "SPEARMAN",
      "valid_range": "[-1, 1]"
    },
    "TS": {
      "failure_condition": "<= 0",
      "formula": "performance_after - performance_before",
      "interpretation": "transfer score (normalized reasoning-efficiency gain)",
      "name": "TS",
      "valid_range": "(-inf, inf)"
    },
    "TU": {
      "failure_condition": "<= 0",
      "formula": "transfer_success * coverage * reasoning_reduction",
      "interpretation": "transfer utility",
      "name": "TU",
      "valid_range": "(-inf, inf)"
    },
    "correlation_n": {
      "failure_condition": "< 4",
      "formula": "number of invariant-level transfer pairs",
      "interpretation": "correlation sample size",
      "name": "CORRELATION_N",
      "valid_range": "[0, inf)"
    },
    "cross_family_reuse": {
      "failure_condition": "== 0",
      "formula": "credited reuse across source and target families",
      "interpretation": "cross-family transfer count",
      "name": "CROSS_FAMILY_REUSE",
      "valid_range": "[0, inf)"
    },
    "cross_family_reuse_rate": {
      "failure_condition": "== 0",
      "formula": "cross-family credited reuse / credited reuse",
      "interpretation": "normalized cross-family transfer rate",
      "name": "CROSS_FAMILY_REUSE_RATE",
      "valid_range": "[0, 1]"
    }
  },
